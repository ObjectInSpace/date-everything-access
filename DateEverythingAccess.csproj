<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DateEverythingAccess</AssemblyName>
    <RootNamespace>DateEverythingAccess</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="decompiled\**" />
    <Compile Remove="templates\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <SceneNavigationDataSourcePath>$(ProjectDir)artifacts\navigation\thirdpersongreybox-navigation-data.json</SceneNavigationDataSourcePath>
    <SceneNavigationDataOutputPath>$(ProjectDir)bin\$(Configuration)\net472\thirdpersongreybox-navigation-data.json</SceneNavigationDataOutputPath>
    <NavigableRegionBakeSourcePath>$(ProjectDir)artifacts\navigation\navigable_region.bake.json</NavigableRegionBakeSourcePath>
    <NavigableRegionBakeOutputPath>$(ProjectDir)bin\$(Configuration)\net472\navigable_region.bake.json</NavigableRegionBakeOutputPath>
  </PropertyGroup>

  <Target Name="CopySceneNavigationDataToOutput" AfterTargets="Build" Condition="Exists('$(SceneNavigationDataSourcePath)')">
    <Copy SourceFiles="$(SceneNavigationDataSourcePath)" DestinationFiles="$(SceneNavigationDataOutputPath)" />
    <Message Text="Copied scene navigation data JSON to $(SceneNavigationDataOutputPath)" Importance="High" />
  </Target>

  <Target Name="CopyNavigableRegionBakeToOutput" AfterTargets="Build" Condition="Exists('$(NavigableRegionBakeSourcePath)')">
    <Copy SourceFiles="$(NavigableRegionBakeSourcePath)" DestinationFiles="$(NavigableRegionBakeOutputPath)" />
    <Message Text="Copied navigable region bake JSON to $(NavigableRegionBakeOutputPath)" Importance="High" />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Team17.Common">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\Team17.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>D:\SteamLibrary\steamapps\Common\Date Everything\Date Everything_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(SkipCopyToPlugins)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="D:\SteamLibrary\steamapps\Common\Date Everything\BepInEx\plugins\" />
    <Copy SourceFiles="$(SceneNavigationDataSourcePath)" DestinationFiles="D:\SteamLibrary\steamapps\Common\Date Everything\BepInEx\plugins\thirdpersongreybox-navigation-data.json" Condition="Exists('$(SceneNavigationDataSourcePath)')" />
    <Copy SourceFiles="$(NavigableRegionBakeSourcePath)" DestinationFiles="D:\SteamLibrary\steamapps\Common\Date Everything\BepInEx\plugins\navigable_region.bake.json" Condition="Exists('$(NavigableRegionBakeSourcePath)')" />
    <Message Text="Copied $(TargetFileName) to BepInEx plugins folder" Importance="High" />
    <!-- Wipe captured C# routes on every deploy: a new DLL or bake invalidates
         them for parity diffing (they were planned against the old planner /
         bake). Keeps c_sharp_routes/ self-limited and the parity check honest. -->
    <RemoveDir Directories="D:\SteamLibrary\steamapps\Common\Date Everything\BepInEx\plugins\c_sharp_routes" Condition="Exists('D:\SteamLibrary\steamapps\Common\Date Everything\BepInEx\plugins\c_sharp_routes')" />
    <Message Text="Cleared stale c_sharp_routes captures" Importance="High" />
  </Target>

</Project>
